  "metadata": {
    "name": "Failure Analysis Evaluation Dataset",
    "version": "1.0",
    "created_date": "2026-03-12",
    "purpose": "Stress-test the RAG system across 6 failure categories to identify systematic weaknesses",
    "total_queries": 50,
    "failure_categories": {
      "cross_document_synthesis": "Requires combining information from 3+ documents",
      "domain_confusion": "Risk of retrieving irrelevant Gutenberg/off-topic chunks",
      "multi_hop_reasoning": "Requires chaining facts across multiple retrieval steps",
      "unanswerable_handling": "Questions with no answer in corpus — tests hallucination resistance",
      "specificity_stress": "Very specific questions that require precise chunk retrieval",
      "comparative_analysis": "Requires comparing two or more concepts/papers side by side"
    }
  },
